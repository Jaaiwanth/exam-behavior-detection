{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DynamoDBExamEvents",
            "Effect": "Allow",
            "Action": [
                "dynamodb:PutItem",
                "dynamodb:GetItem",
                "dynamodb:Query",
                "dynamodb:UpdateItem",
                "dynamodb:DescribeTable"
            ],
            "Resource": [
                "arn:aws:dynamodb:ap-south-1:*:table/exam_events",
                "arn:aws:dynamodb:ap-south-1:*:table/exam_events/index/*"
            ]
        },
        {
            "Sid": "S3RecordingBucketWrite",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::jaaiwanth-exam-monitor-recordings/*"
        },
        {
            "Sid": "S3RecordingBucketList",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::jaaiwanth-exam-monitor-recordings"
        }
    ]
}
