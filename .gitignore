# ============================================================
# AI Exam Behavior Detection — .gitignore
# ============================================================

# ------------------------------------------------------------
# Dataset — real videos must NOT be committed
# The sample directory structure (README.md / .gitkeep files)
# inside dataset/ are tracked via explicit force-add rules.
# See dataset/README.md for instructions.
# ------------------------------------------------------------
dataset/**/*.mp4
dataset/**/*.avi
dataset/**/*.mov
dataset/**/*.mkv
dataset/**/*.webm

# If you prefer to exclude the entire dataset/ folder and rely
# on only sample placeholders, uncomment the line below instead:
# dataset/

# ------------------------------------------------------------
# Outputs — generated at runtime, not committed
# README.md placeholders inside outputs/ are tracked.
# ------------------------------------------------------------
outputs/**/*.npy
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.mp4
outputs/**/*.avi
outputs/**/*.png
outputs/**/*.jpg

# ------------------------------------------------------------
# Model weights — large binary files, not committed
# README.md inside models/ is tracked.
# ------------------------------------------------------------
models/*.pt
models/*.pth
models/*.onnx
models/*.h5
models/*.keras
models/*.pkl
models/*.joblib
models/*.task

# ------------------------------------------------------------
# Python cache and compiled files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.env/

# ------------------------------------------------------------
# Environment variable files
# ------------------------------------------------------------
.env
.env.local
.env.*.local

# ------------------------------------------------------------
# Jupyter notebooks checkpoints
# ------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# ------------------------------------------------------------
# OS / editor generated files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ------------------------------------------------------------
# IDE configuration
# ------------------------------------------------------------
.vscode/settings.json
.idea/

# ------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ------------------------------------------------------------
# Distribution / packaging
# ------------------------------------------------------------
dist/
build/
*.egg-info/
*.egg

# ------------------------------------------------------------
# Large / generated binaries — never commit
# (yolov8n.pt is auto-downloaded by ultralytics on first run;
#  outputs/ artifacts are regenerated by the training scripts;
#  *.mjpeg are fake-webcam clips for the browser e2e test)
# ------------------------------------------------------------
*.pt
outputs/**/*.keras
outputs/**/*.npz
outputs/**/*.txt
*.mjpeg
