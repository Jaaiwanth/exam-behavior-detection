{
  "name": "examproctor-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Emulator tests for ../firestore.rules (run: npm test)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-examproctor --config ../firebase.json \"node --test rules.test.mjs\"",
    "test:rules-only": "node --test rules.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
